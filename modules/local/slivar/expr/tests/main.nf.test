nextflow_process {

    name "Test Process SLIVAR_EXPR"
    script "../main.nf"
    process "SLIVAR_EXPR"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "slivar"
    tag "slivar/expr"

    test("expr_vcf") {
        when {
            params {
                args_modules = "--info 'variant.FILTER == \"PASS\" && variant.ALT[0] != \"*\"'"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/test.vcf", checkIfExists: true),
                    [],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/testa.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.vcf.get(0).get(1)).linesGzip.contains("##fileformat=VCFv4.1") },
                { assert snapshot(process.out.summary, process.out.versions).match() }
            )
        }
    }

    test("js_expr_vcf") {
        when {
            params {
                args_modules = "--trio 'good_qual_trio:hq(kid, mom, dad)' --family-expr 'good_qual_fam:fam.every(hq1)'"
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/test.vcf", checkIfExists: true),
                    [],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/testa.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = file("${moduleTestDir}/test-functions.js", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.vcf.get(0).get(1)).linesGzip.contains("##fileformat=VCFv4.1") },
                { assert snapshot(process.out.summary, process.out.versions).match() }
            )
        }
    }

    test("parental_origin-po_validation") {
        // Reproduces the po_* --trio expressions from conf/slivar.config verbatim
        // (the AF-gate clauses there are empty unless slivar_gnomad_gnotate/
        // slivar_topmed_gnotate are set, which they aren't here) against the real
        // assets/slivar-functions.js and a fixture VCF that was hand-built to hit
        // all 9 possible parental_origin() return labels, one per record -- see
        // subworkflows/local/slivar_inheritance/tests/fixtures/.
        when {
            params {
                args_modules = [
                    "--info 'variant.FILTER == \"PASS\" && variant.ALT[0] != \"*\" && INFO.impactful'",
                    "--trio \"po_denovo:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'DENOVO'\"",
                    "--trio \"po_mother:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'MOTHER'\"",
                    "--trio \"po_father:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'FATHER'\"",
                    "--trio \"po_both:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'BOTH'\"",
                    "--trio \"po_ambiguous:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'AMBIGUOUS'\"",
                    "--trio \"po_possible_denovo:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_DENOVO'\"",
                    "--trio \"po_possible_mother:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_MOTHER'\"",
                    "--trio \"po_possible_father:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_FATHER'\"",
                    "--trio \"po_unknown:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'UNKNOWN'\""
                ].join(" ")
            }
            process {
                """
                input[0] = [
                    [ id:'po_validation' ],
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/po_validation.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/po_validation.vcf.gz.tbi", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/po_validation.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = file("\${projectDir}/assets/slivar-functions.js", checkIfExists: true)
                """
            }
        }

        then {
            def lines = path(process.out.vcf.get(0).get(1)).linesGzip.findAll { !it.startsWith('#') }

            assertAll(
                { assert process.success },
                { assert lines.size() == 16 },
                { assert lines.find { it.startsWith("chr1\t1000\t") }.contains("po_denovo=kid") },
                { assert lines.find { it.startsWith("chr1\t2000\t") }.contains("po_mother=kid") },
                { assert lines.find { it.startsWith("chr1\t3000\t") }.contains("po_father=kid") },
                { assert lines.find { it.startsWith("chr1\t4000\t") }.contains("po_both=kid") },
                { assert lines.find { it.startsWith("chr1\t5000\t") }.contains("po_ambiguous=kid") },
                { assert lines.find { it.startsWith("chr1\t6000\t") }.contains("po_possible_denovo=kid") },
                { assert lines.find { it.startsWith("chr1\t7000\t") }.contains("po_possible_mother=kid") },
                { assert lines.find { it.startsWith("chr1\t8000\t") }.contains("po_unknown=kid") },
                { assert lines.find { it.startsWith("chr1\t9000\t") }.contains("po_possible_denovo=kid") },
                { assert lines.find { it.startsWith("chr1\t10000\t") }.contains("po_possible_denovo=kid") },
                { assert lines.find { it.startsWith("chr1\t11000\t") }.contains("po_unknown=kid") },
                { assert lines.find { it.startsWith("chr1\t12000\t") }.contains("po_unknown=kid") },
                { assert lines.find { it.startsWith("chr1\t13000\t") }.contains("po_father=kid") },
                { assert lines.find { it.startsWith("chrX\t3000000\t") }.contains("po_mother=kid") },
                { assert lines.find { it.startsWith("chrX\t3100000\t") }.contains("po_father=kid") },
                { assert lines.find { it.startsWith("chrY\t3000000\t") }.contains("po_father=kid") }
            )
        }
    }

    test("parental_origin-trio_gating") {
        // Guards the concern behind BIOINFO-217's parental-origin step: the po_*
        // --trio expressions must only ever be evaluated for genuinely complete
        // trios. This fixture packs a real trio alongside a solo sample, a duo
        // with an unknown father, and a family whose PED declares a third member
        // that simply isn't in the VCF -- all sharing one variant record. Only the
        // real trio's kid may end up with a po_* tag.
        when {
            params {
                args_modules = [
                    "--info 'variant.FILTER == \"PASS\" && variant.ALT[0] != \"*\" && INFO.impactful'",
                    "--trio 'comphet_side:comphet_side(kid, mom, dad)'",
                    "--family-expr 'het_side:moi_het_side(fam)'",
                    "--trio \"po_denovo:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'DENOVO'\"",
                    "--trio \"po_mother:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'MOTHER'\"",
                    "--trio \"po_father:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'FATHER'\"",
                    "--trio \"po_both:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'BOTH'\"",
                    "--trio \"po_ambiguous:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'AMBIGUOUS'\"",
                    "--trio \"po_possible_denovo:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_DENOVO'\"",
                    "--trio \"po_possible_mother:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_MOTHER'\"",
                    "--trio \"po_possible_father:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'POSSIBLE_FATHER'\"",
                    "--trio \"po_unknown:parental_origin(variant.CHROM, variant.POS, kid, dad, mom) == 'UNKNOWN'\""
                ].join(" ")
            }
            process {
                """
                input[0] = [
                    [ id:'trio_gating' ],
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/trio_gating.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/trio_gating.vcf.gz.tbi", checkIfExists: true),
                    file("\${projectDir}/subworkflows/local/slivar_inheritance/tests/fixtures/trio_gating.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = file("\${projectDir}/assets/slivar-functions.js", checkIfExists: true)
                """
            }
        }

        then {
            def line = path(process.out.vcf.get(0).get(1)).linesGzip.find { !it.startsWith('#') }

            assertAll(
                { assert process.success },
                { assert line.contains("po_denovo=kid") },
                { assert !line.contains("po_mother=") },
                { assert !line.contains("po_father=") },
                { assert !line.contains("po_both=") },
                { assert !line.contains("po_ambiguous=") },
                { assert !line.contains("po_possible_denovo=") },
                { assert !line.contains("po_possible_mother=") },
                { assert !line.contains("po_possible_father=") },
                { assert !line.contains("po_unknown=") },
                // belt-and-suspenders: no po_* tag ever names a non-trio family member
                { assert !(line =~ /po_\w+=[^;]*\b(solo1|duokid|duomom|kid2|mom2)\b/) }
            )
        }
    }

    test("expr_vcf-stub") {

        options "-stub"

        when {
            params {
                args_modules = "--info 'variant.FILTER == \"PASS\""
            }
            process {
                """
                input[0] = [
                    [ id:'test_stub' ],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/test.vcf", checkIfExists: true),
                    [],
                    file("https://github.com/brentp/slivar/raw/refs/heads/master/tests/testa.ped", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}

process {
    // Reproduces the production ext.args/args2 from conf/modules.config.
    withName: BCFTOOLS_PLUGINFIXPLOIDY {
        ext.prefix = { "${meta.id}.normalized" }
        ext.args   = { '-Oz --write-index=tbi' }
        ext.args2  = { '-f 2' }
    }

    // Reproduces the production container/ext.args from conf/modules.config
    // (the non-merged/refseq branch -- this repo hasn't picked up BIOINFO-220's
    // vep_species/vep_annotation split yet).
    withName: ENSEMBLVEP_VEP {
        container = 'ensemblorg/ensembl-vep:release_114.0'
        ext.args = [
            "--offline",
            "--format vcf",
            "--vcf",
            "--xref_refseq",
            "--variant_class",
            "--numbers",
            "--hgvs",
            "--hgvsg",
            "--canonical",
            "--symbol",
            "--flag_pick",
            "--no_stats",
            "--fields \"Allele,Consequence,IMPACT,SYMBOL,Feature_type,Gene,PICK,Feature,EXON,BIOTYPE,INTRON,HGVSc,HGVSp,STRAND,CDS_position,cDNA_position,Protein_position,Amino_acids,Codons,VARIANT_CLASS,HGVSg,CANONICAL,RefSeq\""
        ].join(" ")
        ext.prefix = { "variants.${meta.id}.snv.vep" }
    }
}

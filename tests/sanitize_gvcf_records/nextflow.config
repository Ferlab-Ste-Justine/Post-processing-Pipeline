process {
    // Both modules carry the process_medium label (6 cpus by default per
    // conf/base.config, which the project's root nextflow.config still pulls
    // in even for this scoped test). withName selectors always beat withLabel
    // ones regardless of config load order, so cpus is capped here alongside
    // the production ext.args from conf/modules.config.
    withName: BCFTOOLS_FILTER {
        cpus = 1
        ext.args = {'-i \'ALT~"NON_REF"\' -Oz --write-index=tbi'}
        ext.prefix = {meta.id + ".filtered"}
    }

    withName: BCFTOOLS_NORM {
        cpus = 1
        ext.args = {'-c w -d all -Oz --write-index=tbi'}
        ext.prefix = {meta.id + ".normalized"}
    }
}

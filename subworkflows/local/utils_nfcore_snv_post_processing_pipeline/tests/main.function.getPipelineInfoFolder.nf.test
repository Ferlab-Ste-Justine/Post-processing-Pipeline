nextflow_function {

    name "Test Subworkflow UTILS_NFCORE_SNV_POST_PROCESSING_PIPELINE getPipelineInfoFolder function"
    script "subworkflows/local/utils_nfcore_snv_post_processing_pipeline/main.nf"
    tag "local"

    function "getPipelineInfoFolder"

    test("Test Function getPipelineInfoFolder") {
        when {
            function {
                """
                input[0] = "path/to/output/directory"
                """
            }
        }
        then {
            assertAll(
                { assert function.success },
                { assert function.result == "path/to/output/directory/pipeline_info" }
            )
        }
    }

    test("Test Function getPipelineInfoFolder with null input") {
        when {
            function {
                """
                input[0] = null
                """
            }
        }
        then {
            assertAll(
                { assert function.failed }
            )
        }
    }
}

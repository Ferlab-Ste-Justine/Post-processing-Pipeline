nextflow_process {

    name "Test fixploidy output annotates cleanly with VEP"
    script "../../modules/nf-core/ensemblvep/vep/main.nf"
    process "ENSEMBLVEP_VEP"
    config "./nextflow.config"

    tag "bcftools"
    tag "ensemblvep"
    tag "fixploidy_to_vep"

    // Lives outside modules/nf-core/**/tests/ and subworkflows/nf-core/**/tests/ on
    // purpose -- both are ignored by nf-test.config. This is pipeline-specific
    // integration coverage, not upstream module boilerplate.
    //
    // Companion to tests/bcftools_pluginfixploidy/main.nf.test: that test locks in
    // *what* `+fixploidy -f 2` produces for a haploid GT (a phased "1|1"/"0|0"
    // diploid expansion -- see its own comments for why that's version-dependent
    // and deliberate). This test answers a different question: does that expanded
    // output actually survive being fed into the next real pipeline stage, VEP,
    // rather than confusing it or getting silently mangled.
    //
    // The toy fixture puts its haploid record on chr22 (not a real non-PAR X/Y
    // site) purely so it lands inside the reduced chr22-only VEP cache/fasta
    // already in data-test/ and gets genuine annotation -- not because `-f 2`
    // itself cares about chromosome: it blindly expands any <2-allele GT
    // regardless of contig, so this still exercises the exact same expansion
    // code path as the real chrX/Y scenario.
    setup {
        run("BCFTOOLS_PLUGINFIXPLOIDY") {
            script "../../modules/nf-core/bcftools/pluginfixploidy/main.nf"
            process {
                """
                input[0] = [
                    [ id:'fixploidy_to_vep_test' ],
                    file("\${projectDir}/tests/fixploidy_to_vep/fixtures/fixploidy_to_vep_test.vcf.gz", checkIfExists: true),
                    file("\${projectDir}/tests/fixploidy_to_vep/fixtures/fixploidy_to_vep_test.vcf.gz.tbi", checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = []
                input[4] = []
                """
            }
        }
    }

    test("fixploidy-expanded haploid GT annotates successfully in VEP") {
        when {
            process {
                """
                input[0] = BCFTOOLS_PLUGINFIXPLOIDY.out.vcf.map { meta, vcf -> [meta, vcf, []] }
                input[1] = "GRCh38"
                input[2] = "homo_sapiens"
                input[3] = 114
                input[4] = file("\${projectDir}/data-test/reference/annotation/.vep", checkIfExists: true)
                input[5] = [ [ id: 'reference' ], file("\${projectDir}/data-test/reference/Homo_sapiens_assembly38/chr22/chr22.fa", checkIfExists: true) ]
                input[6] = []
                """
            }
        }

        then {
            def lines = path(process.out.vcf.get(0).get(1)).linesGzip
            def records = lines.findAll { !it.startsWith('#') }
            def csqHeader = lines.find { it.startsWith("##INFO=<ID=CSQ") }

            assertAll(
                { assert process.success },
                { assert records.size() == 2 },
                // Not just present -- its Format: list must actually be populated with
                // the fields this pipeline configures (conf/modules.config's --fields),
                // not an empty/default declaration.
                { assert csqHeader != null && csqHeader.contains("Format: Allele|Consequence|IMPACT|SYMBOL") },
                // GT itself must survive VEP untouched -- VEP annotates INFO/CSQ, it
                // doesn't rewrite sample genotype columns. Confirms the fixploidy
                // expansion (including its phased "|") isn't mangled downstream.
                { assert records.find { it.startsWith("chr22\t50000101\t") }.contains("\t1|1:0,20:20") },
                { assert records.find { it.startsWith("chr22\t50000201\t") }.contains("\t0/1:10,10:20") },
                // Both records fall inside the reduced chr22 test cache, so both
                // should get a real (non-empty) CSQ annotation, not just a bare
                // "CSQ=" left over from a cache miss.
                { assert records.every { it =~ /CSQ=[^\t;]+/ } }
            )
        }
    }
}
